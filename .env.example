# Base path the site is served under.
#   GitHub Pages project site : /repository-name/
#   User/org site or domain   : /
# The GitHub Actions workflow sets this automatically from the repo name.
VITE_BASE_PATH=/

# Absolute site URL used for canonical links, Open Graph and the sitemap.
#   e.g. https://username.github.io/repository-name
VITE_SITE_URL=https://chrismuscatphotography.com

# Password for the private gallery at /private
# Set this to a secure password. Fallback is 'muscat2024'
VITE_PRIVATE_PASSWORD=your-secure-password-here
